# Board: Espressif ESP8266 ESP-12E
# Definition: definitions/boards/esp12e/manifest.yaml

esphome:
  name: blinker
  friendly_name: Blinker

esp8266:
  board: esp12e

logger:

api:
  encryption:
    key: "<autogenerated>"

ota:
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  ap:
    ssid: Blinker Fallback Hotspot
    password: "<your-password>"

captive_portal:


output:
  - platform: gpio
    pin: GPIO2
    id: blinker_debug_led
  - platform: gpio
    pin: GPIO4
    id: blinker_light

# Tracks what the LED should return to after a blink cycle
globals:
  - id: light_state
    type: bool
    restore_value: yes
    initial_value: 'false'

# Sun position calculation (correct your location)
sun:
  latitude: 20.05°  # Put your loation here
  longitude: 20.05°

# Blink script
script:
  - id: blink_eyes
    mode: restart
    then:
      - repeat:
          count: 15
          then:
            - output.turn_on: blinker_debug_led
            - output.turn_on: blinker_light
            - delay: 1s
            - output.turn_off: blinker_debug_led
            - output.turn_off: blinker_light
            - delay: 100ms
      - if:
          condition:
            lambda: 'return id(light_state);'
          then:
            - output.turn_on: blinker_debug_led
            - output.turn_on: blinker_light
          else:
            - output.turn_off: blinker_debug_led
            - output.turn_off: blinker_light

# Eye Break Active: momentary trigger button
button:
  - platform: template
    name: "Eye Break Active"
    id: eye_break_button
    on_press:
      then:
        - script.execute: blink_eyes

switch:
  # light script
  - platform: template
    name: "Light"
    id: light_switch
    optimistic: true
    restore_mode: RESTORE_DEFAULT_OFF
    turn_on_action:
      - globals.set:
          id: light_state
          value: 'true'
      - output.turn_on: blinker_debug_led
      - output.turn_on: blinker_light
    turn_off_action:
      - globals.set:
          id: light_state
          value: 'false'
      - output.turn_off: blinker_debug_led
      - output.turn_off: blinker_light

# Physical buttons
binary_sensor:
  - platform: gpio
    pin:
      number: GPIO5  # change to a free GPIO on your board if needed
      mode:
        input: true
        pullup: true
      inverted: true
    name: "Light Button"
    id: led_button
    filters:
      - delayed_on: 20ms
      - delayed_off: 20ms
    on_press:
      then:
        - switch.toggle: light_switch

  - platform: template
    name: "Break Active"
    id: light_switch_sensor
    device_class: running
    lambda: |-
      return id(blink_eyes).is_running();

# Time sync from Home Assistant
time:
  - platform: homeassistant
    id: ha_time
    on_time_sync:
      # Set LED correctly the moment we get valid time (e.g. right after boot)
      then:
        - if:
            condition:
              sun.is_above_horizon:
            then:
              - switch.turn_off: light_switch
            else:
              - switch.turn_on: light_switch
    on_time:
      # Fallback in case sun data is ever unavailable - fixed 7:00/19:00
      - seconds: 0
        minutes: 0
        hours: 7
        then:
          - switch.turn_off: light_switch
      - seconds: 0
        minutes: 0
        hours: 19
        then:
          - switch.turn_on: light_switch

# 20-20-20 blink timer + periodic daylight re-check
interval:
  - interval: 20min
    then:
      - script.execute: blink_eyes

  - interval: 5min
    then:
      - if:
          condition:
            sun.is_above_horizon:
          then:
            - switch.turn_off: light_switch
          else:
            - switch.turn_on: light_switch
