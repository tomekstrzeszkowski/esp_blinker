#...default config
output:
  - platform: gpio
    pin: GPIO2
    id: blinker_output

# --- Tracks what the LED should return to after a blink cycle ---
globals:
  - id: light_state
    type: bool
    restore_value: yes
    initial_value: 'false'

# --- Sun position calculation (correct your location) ---
sun:
  latitude: 20.05°
  longitude: 20.05°

# --- Blink script: 1s on / 0.3s off, ~20s total, then restore LED state ---
script:
  - id: blink_eyes
    mode: restart
    then:
      - repeat:
          count: 15
          then:
            - output.turn_on: blinker_output
            - delay: 1s
            - output.turn_off: blinker_output
            - delay: 300ms
      - if:
          condition:
            lambda: 'return id(light_state);'
          then:
            - output.turn_on: blinker_output
          else:
            - output.turn_off: blinker_output

# --- Eye Break Active: momentary trigger button ---
button:
  - platform: template
    name: "Eye Break Active"
    id: eye_break_button
    on_press:
      then:
        - script.execute: blink_eyes

switch:
  # --- light: plain steady on/off, independent of blinking ---
  - platform: template
    name: "light"
    id: light_switch
    optimistic: true
    restore_mode: RESTORE_DEFAULT_OFF
    turn_on_action:
      - globals.set:
          id: light_state
          value: 'true'
      - output.turn_on: blinker_output
    turn_off_action:
      - globals.set:
          id: light_state
          value: 'false'
      - output.turn_off: blinker_output

# --- Physical buttons ---
binary_sensor:
  - platform: gpio
    pin:
      number: GPIO5
      mode:
        input: true
        pullup: true
      inverted: true
    name: "Physical Button"
    id: physical_button
    filters:
      - delayed_on: 20ms
      - delayed_off: 20ms
    on_press:
      then:
        - script.execute: blink_eyes

  - platform: gpio
    pin:
      number: GPIO4        # <-- change to a free GPIO on your board if needed
      mode:
        input: true
        pullup: true
      inverted: true
    name: "LED Button"
    id: led_button
    filters:
      - delayed_on: 20ms
      - delayed_off: 20ms
    on_press:
      then:
        - switch.toggle: light_switch

# --- Time sync from Home Assistant ---
time:
  - platform: homeassistant
    id: ha_time
    on_time_sync:
      # Set LED correctly the moment we get valid time (e.g. right after boot)
      then:
        - if:
            condition:
              sun.is_above_horizon:
            then:
              - switch.turn_off: light_switch
            else:
              - switch.turn_on: light_switch
    on_time:
      # Fallback in case sun data is ever unavailable - fixed 7:00/19:00
      - seconds: 0
        minutes: 0
        hours: 7
        then:
          - switch.turn_off: light_switch
      - seconds: 0
        minutes: 0
        hours: 19
        then:
          - switch.turn_on: light_switch

# --- 20-20-20 blink timer + periodic daylight re-check ---
interval:
  - interval: 20min
    then:
      - script.execute: blink_eyes

  - interval: 5min
    then:
      - if:
          condition:
            sun.is_above_horizon:
          then:
            - switch.turn_off: light_switch
          else:
            - switch.turn_on: light_switch